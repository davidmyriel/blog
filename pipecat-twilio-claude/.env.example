# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model, e.g. claude-haiku-5-5 for lower latency/cost
# ANTHROPIC_MODEL=claude-opus-5-5

# Speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Text-to-speech (https://play.cartesia.ai)
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# Twilio (https://console.twilio.com, Account Info on the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Your own phone number(s) — the phone you call FROM, not the Twilio number.
# Comma-separated. Calls from any other number are rejected.
ALLOWED_CALLERS=

# Calls end automatically after this many minutes.
MAX_CALL_MINUTES=10

# Public hostname for local runs with ngrok (no https://). Not needed on Railway.
# PUBLIC_HOST=abc123.ngrok.app
