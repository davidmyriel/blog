# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model, e.g. claude-haiku-5-5 for lower latency/cost
# ANTHROPIC_MODEL=claude-opus-5-5

# Speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Text-to-speech (https://play.cartesia.ai)
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# Twilio (https://console.twilio.com) — used to hang up the call cleanly
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
